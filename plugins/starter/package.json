{
  "name": "orbit-starter-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "A complete, minimal Orbit Commerce plugin \u2014 the fundamentals in one place",
  "scripts": {
    "dev": "prisma generate && prisma db push --skip-generate && next dev -p 3030",
    "build": "prisma generate && next build",
    "start": "next start -p 3030",
    "worker": "tsx worker/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@orbitcommerce/sdk": "^2.0.0",
    "next": "^15.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "prisma": "^6.1.0"
  }
}
