# The plugin's own database. SQLite so this runs with no infrastructure;
# real plugins use Postgres — change the provider in prisma/schema.prisma too.
DATABASE_URL="file:./.data/starter.db"

# Which Orbit API to talk to.
ORBIT_API_URL=https://api.myorbitcommerce.net

# Encrypts stored access and refresh tokens (see lib/orbit-auth.ts).
# Generate with: openssl rand -hex 32
# Changing it makes every stored connection unreadable — merchants reconnect.
TOKEN_ENCRYPTION_KEY=

# Verifies inbound webhooks. Issued per plugin by the platform; find it in the
# partner dashboard. Without it the receiver rejects everything.
WEBHOOK_SECRET=

# Where Orbit should POST events. Must be HTTPS and reachable from outside —
# use a tunnel in development. Leave blank to skip subscribing and poll instead.
ORBIT_WEBHOOK_URL=

# How often the worker runs. Default 5 minutes.
SYNC_INTERVAL_MS=300000

# OPTIONAL, development only: restrict the worker to one store while you work
# on it. Leave blank normally — a store id is never configuration.
ORBIT_STORE_ID=

# Served under a sub-path when embedded. Blank for local development.
NEXT_PUBLIC_BASE_PATH=
PORT=3030
