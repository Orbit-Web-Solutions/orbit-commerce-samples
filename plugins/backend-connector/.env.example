# Orbit API host the connector talks to.
ORBIT_API_URL=https://api.myorbitcommerce.net

# Encrypts the stored access and refresh tokens (see lib/orbit-auth.ts).
# Generate one with: openssl rand -hex 32
# Changing it makes every stored connection unreadable — merchants must reconnect.
TOKEN_ENCRYPTION_KEY=

# The store this worker syncs. The connect page prints it after a successful
# handshake; there is nothing to set here until then.
ORBIT_STORE_ID=

# How often the worker runs a pass. Default 5 minutes.
SYNC_INTERVAL_MS=300000

# Served under a sub-path when embedded. Leave blank for local development.
NEXT_PUBLIC_BASE_PATH=
PORT=3030

# Where Orbit should POST webhook events. Must be HTTPS and reachable from
# outside your network. Leave blank to fall back to polling.
ORBIT_WEBHOOK_URL=
